# =============================================================================
# Variáveis de ambiente da API — Mentalidade
# Copie este arquivo para .env e ajuste os valores conforme o ambiente.
# =============================================================================

# Ambiente de execução: development | test | production
NODE_ENV=production

# Porta HTTP da API (utilizada em desenvolvimento e produção).
# Padrão do projeto: 3344 (evita conflito com outros serviços locais).
PORT=3344

# Banco de dados PostgreSQL (Neon). Em produção, mantenha sslmode=require.
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/mentalidade?sslmode=require&schema=public

# Segredo e validade do token JWT (o segredo deve ter no mínimo 16 caracteres).
JWT_SECRET=troque-por-um-segredo-forte-com-no-minimo-16-caracteres
JWT_EXPIRES_IN=1d

# Origem permitida no CORS (endereço público do frontend).
# Desenvolvimento: http://localhost:5180
# Produção:        https://mentalidade.exemplo.com
CORS_ORIGIN=https://mentalidade.exemplo.com
